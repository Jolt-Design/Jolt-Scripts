{
  "name": "@joltdesign/scripts",
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "bin": {
    "jolt": "./dist/cli.js"
  },
  "version": "2.0.0",
  "type": "module",
  "jira-prepare-commit-msg": {
    "messagePattern": "$J $M",
    "ignoredBranchesPattern": "^(dependabot/|renovate/)"
  },
  "files": [
    "/dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && yarn run generate-schema",
    "clean": "rimraf dist",
    "debug": "node --inspect-brk ./dist/cli.js",
    "generate-schema": "yarn node ./scripts/generate-schema.js && yarn lint --write jolt-config.schema.json",
    "lint": "biome check",
    "fmt": "biome format",
    "prepack": "run build",
    "prepare": "jolt prepare",
    "test": "vitest",
    "test:coverage": "vitest --coverage.enabled=true",
    "test:run": "vitest run",
    "watch": "tsc -w"
  },
  "dependencies": {
    "ansis": "^4.4.0",
    "change-case": "^5.4.4",
    "clipanion": "^4.0.0-rc.4",
    "dotenv": "^18.0.3",
    "execa": "^10.0.1",
    "object-resolve-path": "^1.1.1",
    "typanion": "^3.14.0",
    "which": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.13.6",
    "@types/which": "^3.0.4",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
