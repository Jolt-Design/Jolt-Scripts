{
  "name": "@joltdesign/scripts",
  "packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba",
  "bin": {
    "jolt": "./bin/jolt.js"
  },
  "version": "2.4.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jolt-Design/Jolt-Scripts.git"
  },
  "jira-prepare-commit-msg": {
    "messagePattern": "$J $M",
    "ignoredBranchesPattern": "^(dependabot/|renovate/)"
  },
  "files": [
    "/bin",
    "/dist",
    "/docs",
    "/php"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && yarn run generate-schema",
    "clean": "rimraf dist",
    "debug": "node --inspect-brk ./dist/cli.js",
    "fmt": "biome format",
    "generate-schema": "yarn node ./scripts/generate-schema.js && yarn lint --write jolt-config.schema.json",
    "lint": "biome check",
    "prepack": "run build",
    "prepare": "jolt prepare",
    "test": "vitest",
    "test:coverage": "vitest --coverage.enabled=true",
    "test:run": "vitest run",
    "watch": "tsc -w"
  },
  "dependencies": {
    "ansis": "^4.5.0",
    "change-case": "^5.4.4",
    "clipanion": "^4.0.0-rc.4",
    "dotenv": "^18.0.10",
    "execa": "^10.2.1",
    "object-resolve-path": "^1.1.1",
    "typanion": "^3.14.0",
    "which": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^24.19.2",
    "@types/which": "^3.0.4",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
